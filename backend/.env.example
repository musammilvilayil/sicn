# Backend environment configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/indoor_navigation
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Comma-separated frontend origins. Leave empty for same-origin/local development only.
CLIENT_ORIGIN=http://localhost:5173
# Optional first-admin identity. A one-time strong password is generated and printed on first startup.
BOOTSTRAP_ADMIN_EMAIL=admin@bji.ac.in
BOOTSTRAP_ADMIN_NAME=Campus Administrator
# Never enable in production.
ALLOW_DESTRUCTIVE_SEED=false
